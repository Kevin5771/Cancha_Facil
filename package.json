{
  "name": "canchafacil",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema web de reservación de canchas deportivas - Análisis de Sistemas II",
  "scripts": {
    "start": "node scripts/start-local.js",
    "levantar": "node scripts/start-local.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/check-front.js",
    "test:comunidad": "node scripts/check-community.js",
    "test:chat": "node scripts/check-chat.js",
    "test:editar-cancha": "node scripts/check-court-edit.js",
    "test:admin": "node scripts/check-admin.js",
    "test:accesibilidad": "node scripts/check-accessibility.js",
    "db:init": "node scripts/init-db.js",
    "db:respaldo": "node scripts/database-tools.js backup",
    "db:restaurar": "node scripts/database-tools.js restore",
    "db:verificar-respaldo": "node scripts/database-tools.js verify",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "crear-admin": "node scripts/create-admin.js",
    "usuarios-prueba": "node scripts/create-test-users.js",
    "datos-demo": "node scripts/seed-demo.js",
    "datos-realistas": "node scripts/seed-realistic.js",
    "datos-comunidad": "node scripts/seed-community.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "lucide-static": "^1.60.0"
  }
}
